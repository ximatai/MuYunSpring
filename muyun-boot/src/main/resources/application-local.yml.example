# Copy to application-local.yml for local development. The real local override is ignored by Git.
spring:
  config:
    activate:
      on-profile: local
  datasource:
    url: ${MUYUN_DB_URL:jdbc:postgresql://127.0.0.1:54321/muyun_spring}
    username: ${MUYUN_DB_USERNAME:postgres}
    password: ${MUYUN_DB_PASSWORD:muyun_dev}

muyun:
  runtime:
    mode: development
  web:
    cors:
      allowed-origins:
        - http://127.0.0.1:5173
        - http://localhost:5173
  initial-admin:
    initial-password: ${MUYUN_INITIAL_ADMIN_PASSWORD:admin123}
  # External identity federation with the development-only mock provider. Create an identity provider of
  # type "mock" as platform admin, add it under the tenant's external sign-in methods, then open the
  # workbench with ?tenant=<tenantId> to see the scan sign-in entry.
  # iam:
  #   federation:
  #     enabled: true
  #     api-base-url: http://127.0.0.1:8080/api
  #     workbench-url: http://127.0.0.1:5173/app/
  #     mock:
  #       enabled: true
  #     # WeLink requires an explicit muyun-iam-welink dependency in the consumer application.
  #     # Set provider credentials via an environment-variable reference in the identity provider record.
  #     # Register the exact workbench-url on WeLink; production URLs must use HTTPS.
  #     # welink:
  #     #   enabled: true
  security:
    # To enable encrypted and signed field protection, uncomment and set a Base64-encoded
    # 16/24/32-byte AES master key through a local secret environment variable.
    # field-protection:
    #   key-base64: ${MUYUN_SECURITY_FIELD_PROTECTION_KEY_BASE64}
