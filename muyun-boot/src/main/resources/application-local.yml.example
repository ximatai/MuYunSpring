# Copy to application-local.yml for local development. The real local override is ignored by Git.
spring:
  config:
    activate:
      on-profile: local
  datasource:
    url: ${MUYUN_DB_URL:jdbc:postgresql://127.0.0.1:54321/muyun_spring}
    username: ${MUYUN_DB_USERNAME:postgres}
    password: ${MUYUN_DB_PASSWORD:muyun_dev}

muyun:
  runtime:
    mode: development
  web:
    cors:
      allowed-origins:
        - http://127.0.0.1:5173
        - http://localhost:5173
  initial-admin:
    initial-password: ${MUYUN_INITIAL_ADMIN_PASSWORD:admin123}
  security:
    # To enable encrypted and signed field protection, uncomment and set a Base64-encoded
    # 16/24/32-byte AES master key through a local secret environment variable.
    # field-protection:
    #   key-base64: ${MUYUN_SECURITY_FIELD_PROTECTION_KEY_BASE64}
