{
  "name": "muyun-web",
  "private": true,
  "version": "0.26.33-SNAPSHOT",
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode backend",
    "dev:backend": "vite --host 127.0.0.1 --mode backend",
    "typecheck": "node scripts/run-verified.mjs typecheck node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "build": "npm run typecheck && node scripts/run-verified.mjs host-build node_modules/vite/bin/vite.js build",
    "version:check": "node ../scripts/version.mjs check",
    "version:test": "node --test ../scripts/version.test.mjs",
    "pack:consumer": "node scripts/pack-consumer.mjs",
    "prepare:consumer": "node scripts/prepare-consumer.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "check": "node scripts/check.mjs",
    "test:local": "node scripts/run-verified.mjs local-tests node_modules/vitest/vitest.mjs run --project unit --project component",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "node scripts/run-verified.mjs tests node_modules/vitest/vitest.mjs run",
    "lint": "eslint . && npm run check:boundaries",
    "lint:fix": "eslint . --fix && npm run check:boundaries",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview --host 127.0.0.1",
    "test:watch": "vitest",
    "test:unit": "node scripts/run-verified.mjs unit-tests node_modules/vitest/vitest.mjs run --project unit",
    "test:component": "node scripts/run-verified.mjs component-tests node_modules/vitest/vitest.mjs run --project component",
    "test:browser": "node scripts/run-verified.mjs browser-tests node_modules/vitest/vitest.mjs run --project browser"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/x6": "3.1.8",
    "@dagrejs/dagre": "3.1.1",
    "@noble/hashes": "2.4.0",
    "@scalar/api-reference": "^1.64.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/vue-query": "^5.101.0",
    "ant-design-vue": "^4.2.6",
    "dayjs": "^1.11.21",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.3.2",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.29.3",
    "vue": "^3.5.38",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
