{
  "name": "muyun-web",
  "private": true,
  "version": "0.26.12",
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode backend",
    "dev:backend": "vite --host 127.0.0.1 --mode backend",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "pack:consumer": "node scripts/pack-consumer.mjs",
    "verify:consumer": "npm run pack:consumer && node scripts/verify-consumer.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "lint": "eslint . && npm run check:boundaries",
    "lint:fix": "eslint . --fix && npm run check:boundaries",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview --host 127.0.0.1",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@scalar/api-reference": "^1.64.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/vue-query": "^5.101.0",
    "ant-design-vue": "^4.2.6",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.29.3",
    "vue": "^3.5.38",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
